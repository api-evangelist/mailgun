{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mailgun Domains Events API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query the events log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mailgun.net/v3/:domain/events",
            "params": [
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "event",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query the events log"
        }
      ]
    }
  ],
  "bundled": true
}